rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          'email' in request.auth.token &&
          'email_verified' in request.auth.token &&
          request.auth.token.email == 'mzmdagosh@gmail.com' &&
          request.auth.token.email_verified == true
        )
      );
    }

    // 3. Entity Validation Blueprints
    function isValidRole(role) {
      return role is string && role.size() >= 4 && role.size() <= 16 &&
             role in ['ADMIN', 'MODERATOR', 'ADVISOR', 'MEMBER', 'admin', 'moderator', 'advisor', 'member'];
    }

    function isValidStatus(status) {
      return status is string && status.size() >= 6 && status.size() <= 16 &&
             status in ['ACTIVE', 'SUSPENDED', 'active', 'suspended'];
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt']) &&
             isValidId(data.uid) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             isValidRole(data.role) &&
             isValidStatus(data.status) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 4. Collection Rules: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());

      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == userId &&
                       (
                         (
                           request.auth.uid == userId &&
                           incoming().role in ['MEMBER', 'member'] &&
                           incoming().status in ['ACTIVE', 'active']
                         ) ||
                         isAdmin()
                       );

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (
                           request.auth.uid == userId &&
                           incoming().role == existing().role &&
                           incoming().status == existing().status &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
                         ) ||
                         (
                           isAdmin() &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'displayName', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() && isValidId(userId) && isAdmin();
    }

    // 5. Collection Rules: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list, create, update, delete: if false;
    }
  }
}
